# ? ----------------------------------------------------------------------------
# ? Build stage for the Classeq CLI
#
# Builds `cls` from the repository sources with the locked dependencies.
# ? ----------------------------------------------------------------------------
FROM rust:1-slim-bookworm AS builder

WORKDIR /home/classeq

COPY . .

RUN cargo install --locked --path ports/cli --root /opt/classeq


# ? ----------------------------------------------------------------------------
# ? Run stage
#
# The CLI is a single binary. Tree rooting is built in (`cls root-tree`), so
# the image needs no Python.
# ? ----------------------------------------------------------------------------
FROM debian:bookworm-slim

COPY --from=builder /opt/classeq/bin/cls /usr/bin/cls

ENTRYPOINT ["cls"]
